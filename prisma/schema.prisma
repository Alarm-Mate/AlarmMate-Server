generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  password                String
  nickname                String           @unique
  profileImageUrl         String?
  wakeGoalTime            String?
  birthDate               String?
  timezone                String?
  bio                     String?
  notificationsEnabled    Boolean          @default(true)
  wakeStreak              Int              @default(0)
  totalWakeDays           Int              @default(0)
  oneSignalSubscriptionId String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  refreshTokens           RefreshToken[]
  alarms                  Alarm[]
  groupMembers            GroupMember[]
  wakeRecords             WakeRecord[]
  followers               Follow[]         @relation("Following")
  following               Follow[]         @relation("Follower")
  notifications           Notification[]
  sentInvitations         GroupInvitation[] @relation("InvitedBy")
  receivedInvitations     GroupInvitation[] @relation("InvitedUser")
  passwordResetTokens     PasswordResetToken[]
  sounds                  Sound[]
  blocksMade              UserBlock[]      @relation("Blocker")
  blocksReceived          UserBlock[]      @relation("Blocked")
  reportsMade             UserReport[]     @relation("Reporter")
  reportsReceived         UserReport[]     @relation("Reported")
}

// UGC 보호: 사용자 차단. 차단하면 양방향 팔로우 해제 + 검색/탐색에서 상호 숨김.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// UGC 신고 접수(운영 검토용 보관)
model UserReport {
  id         String   @id @default(cuid())
  reporterId String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User     @relation("Reported", fields: [targetId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // 코드 오입력 횟수(무차별 대입 방지)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 코드 오입력 횟수(무차별 대입 방지)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
}

model Alarm {
  id        String       @id @default(cuid())
  userId    String
  // 클라이언트(iOS AlarmKit) 측 알람 식별자(UUID). 재설치/재시작 후 네이티브 알람 매칭용.
  clientId  String?
  name      String
  time      String?
  days      Int[]
  isEnabled Boolean      @default(true)
  vibration Boolean      @default(true)
  isOneTime Boolean      @default(false) // 1회성 알람(울린 뒤 자동 삭제)
  soundId   String?
  type      AlarmType    @default(PERSONAL)
  groupId   String?
  placeName String?
  latitude  Float?
  longitude Float?
  radius    Int?
  locationTrigger LocationTrigger?
  // 막차 알람(LAST_TRANSIT): 출발지·목적지 + ODsay 계산 결과(표시용).
  originName       String?
  originLat        Float?
  originLng        Float?
  destName         String?
  destLat          Float?
  destLng          Float?
  lastDeparture    String? // 막차 출발 "HH:mm"
  boardingStopName String? // 탑승 정류장/역
  walkMinutes      Int? // 출발지→정류장 도보(분)
  lastTransitRefined Boolean @default(false) // 발사 30분 전 재계산 완료 여부
  // 약속 알람(APPOINTMENT)
  appointmentTime  String? // 약속 시각 "HH:mm"
  prepMinutes      Int? // 준비 시간(분)
  travelMinutes    Int? // 이동 시간(분, 계산값)
  appointmentRefineStage Int @default(0) // 약속 재계산 단계: 0=없음, 1=2h전, 2=30m전
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?       @relation(fields: [groupId], references: [id])
  wakeRecords WakeRecord[]
}

enum AlarmType {
  PERSONAL
  GROUP
  LOCATION
  LAST_TRANSIT
  APPOINTMENT
}

enum LocationTrigger {
  ARRIVE
  LEAVE
}

model Group {
  id          String            @id @default(cuid())
  name        String
  alarmTime   String
  days        Int[]
  isOneTime   Boolean           @default(false) // 1회성 그룹(울린 뒤 그룹 전체 자동 삭제)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     GroupMember[]
  alarms      Alarm[]
  invitations GroupInvitation[]
  wakeRecords WakeRecord[]
  ringSessions GroupRingSession[]
}

// 그룹 자동 재울림 세션: 알람 시각에 시작되어, 모든 멤버가 깰 때까지(또는 최대 시도까지)
// 안 깬 멤버에게 주기적으로 재울림 푸시를 보낸다. 그룹 + KST 날짜당 1개.
model GroupRingSession {
  id         String            @id @default(cuid())
  groupId    String
  date       String // KST yyyy-MM-dd
  status     RingSessionStatus @default(ACTIVE)
  attempts   Int               @default(0)
  startedAt  DateTime          @default(now())
  lastRingAt DateTime?
  endedAt    DateTime?
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([status])
}

enum RingSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  isEnabled Boolean         @default(true)
  vibration Boolean         @default(true)
  soundId   String?
  joinedAt  DateTime        @default(now())
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

model GroupInvitation {
  id          String           @id @default(cuid())
  groupId     String
  invitedById String
  userId      String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // 초대를 보낸/받은 유저가 탈퇴해도 회원 삭제가 막히지 않도록 Cascade(초대 이력 함께 삭제).
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  user        User             @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model WakeRecord {
  id        String   @id @default(cuid())
  userId    String
  // 알람이 삭제되어도(일회성/약속/막차 자동 삭제) 기상 이력은 보존해야 하므로 SetNull(nullable).
  alarmId   String?
  groupId   String?
  date      String // KST yyyy-MM-dd (하루 1건, 날짜별 이력 보존)
  wokeAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alarm     Alarm?   @relation(fields: [alarmId], references: [id], onDelete: SetNull)
  // 그룹 삭제(1회성 그룹 자동 삭제 등)돼도 기상 이력은 프로필에 남도록 SetNull.
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([userId, alarmId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  isRead    Boolean          @default(false)
  payload   Json
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  GROUP_INVITE
  MEMBER_WOKE_UP
  ALL_MEMBERS_WOKE_UP
  NEW_FOLLOWER
  REACTION
}

model Sound {
  id        String   @id @default(cuid())
  name      String
  url       String
  userId    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
