generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  password                String
  nickname                String           @unique
  profileImageUrl         String?
  wakeGoalTime            String?
  birthDate               String?
  timezone                String?
  bio                     String?
  notificationsEnabled    Boolean          @default(true)
  wakeStreak              Int              @default(0)
  totalWakeDays           Int              @default(0)
  oneSignalSubscriptionId String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  refreshTokens           RefreshToken[]
  alarms                  Alarm[]
  groupMembers            GroupMember[]
  wakeRecords             WakeRecord[]
  followers               Follow[]         @relation("Following")
  following               Follow[]         @relation("Follower")
  notifications           Notification[]
  sentInvitations         GroupInvitation[] @relation("InvitedBy")
  receivedInvitations     GroupInvitation[] @relation("InvitedUser")
  passwordResetTokens     PasswordResetToken[]
  sounds                  Sound[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
}

model Alarm {
  id        String       @id @default(cuid())
  userId    String
  // 클라이언트(iOS AlarmKit) 측 알람 식별자(UUID). 재설치/재시작 후 네이티브 알람 매칭용.
  clientId  String?
  name      String
  time      String?
  days      Int[]
  isEnabled Boolean      @default(true)
  vibration Boolean      @default(true)
  soundId   String?
  type      AlarmType    @default(PERSONAL)
  groupId   String?
  placeName String?
  latitude  Float?
  longitude Float?
  radius    Int?
  locationTrigger LocationTrigger?
  // 막차 알람(LAST_TRANSIT): 출발지·목적지 + ODsay 계산 결과(표시용).
  originName       String?
  originLat        Float?
  originLng        Float?
  destName         String?
  destLat          Float?
  destLng          Float?
  lastDeparture    String? // 막차 출발 "HH:mm"
  boardingStopName String? // 탑승 정류장/역
  walkMinutes      Int? // 출발지→정류장 도보(분)
  lastTransitRefined Boolean @default(false) // 발사 30분 전 재계산 완료 여부
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?       @relation(fields: [groupId], references: [id])
  wakeRecords WakeRecord[]
}

enum AlarmType {
  PERSONAL
  GROUP
  LOCATION
  LAST_TRANSIT
}

enum LocationTrigger {
  ARRIVE
  LEAVE
}

model Group {
  id          String            @id @default(cuid())
  name        String
  alarmTime   String
  days        Int[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     GroupMember[]
  alarms      Alarm[]
  invitations GroupInvitation[]
  wakeRecords WakeRecord[]
  ringSessions GroupRingSession[]
}

// 그룹 자동 재울림 세션: 알람 시각에 시작되어, 모든 멤버가 깰 때까지(또는 최대 시도까지)
// 안 깬 멤버에게 주기적으로 재울림 푸시를 보낸다. 그룹 + KST 날짜당 1개.
model GroupRingSession {
  id         String            @id @default(cuid())
  groupId    String
  date       String // KST yyyy-MM-dd
  status     RingSessionStatus @default(ACTIVE)
  attempts   Int               @default(0)
  startedAt  DateTime          @default(now())
  lastRingAt DateTime?
  endedAt    DateTime?
  group      Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, date])
  @@index([status])
}

enum RingSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  isEnabled Boolean         @default(true)
  vibration Boolean         @default(true)
  soundId   String?
  joinedAt  DateTime        @default(now())
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

model GroupInvitation {
  id          String           @id @default(cuid())
  groupId     String
  invitedById String
  userId      String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  user        User             @relation("InvitedUser", fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model WakeRecord {
  id        String   @id @default(cuid())
  userId    String
  alarmId   String
  groupId   String?
  wokeAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alarm     Alarm    @relation(fields: [alarmId], references: [id])
  group     Group?   @relation(fields: [groupId], references: [id])

  @@unique([userId, alarmId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  isRead    Boolean          @default(false)
  payload   Json
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  GROUP_INVITE
  MEMBER_WOKE_UP
  ALL_MEMBERS_WOKE_UP
  NEW_FOLLOWER
  REACTION
}

model Sound {
  id        String   @id @default(cuid())
  name      String
  url       String
  userId    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
