DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alarmmate?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="30d"
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""
# 파일 스토리지 (S3 호환). AWS S3 / Cloudflare R2 / MinIO 모두 지원.
#  - AWS S3:      AWS_REGION + 키만 채우고 S3_ENDPOINT/S3_PUBLIC_BASE_URL 비움
#  - Cloudflare R2: 아래 주석 참고 (AWS_REGION="auto")
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="alarmmate-uploads"
# S3 호환 커스텀 엔드포인트. R2 예시: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# 공개 URL 베이스. R2 예시: https://pub-xxxxxxxx.r2.dev (버킷 Public Access 활성화 시 발급)
S3_PUBLIC_BASE_URL=""
# 이메일 (SendGrid). 비번 재설정 코드·가입 축하 메일. 미설정 시 콘솔에 로그만.
#  - SendGrid 가입 → Single Sender 인증(이메일 1개) → API Key 발급
MAIL_FROM=""           # SendGrid에서 인증한 발신 이메일
SENDGRID_API_KEY=""
PORT="3000"
# 그룹 자동 재울림 (cron 30초 틱). 안 깬 멤버에게 재울림 푸시 보내는 간격/최대 시도.
RING_SCHEDULER_ENABLED="true"   # 끄려면 "false"
RERING_INTERVAL_MS="120000"     # 재울림 간격(ms) 기본 2분
RERING_MAX_ATTEMPTS="8"         # 최대 재울림 횟수 (이후 세션 EXPIRED)
